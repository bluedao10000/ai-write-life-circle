  "info": {
    "title": "Writer Agent Author Workspace Management",
    "version": "1.0.0",
    "description": "Go-only managed structures. Ordered arrays, baseVersion CAS, atomic ownership/audit/idempotency. Existing Markdown revisions, Notes, Review and Publication routes remain unchanged.",
    "license": {
      "name": "Private",
      "url": "https://github.com/story2u/ai-write-life-circle"
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8787/v1",
      "description": "Isolated local development"
    }
  ],
