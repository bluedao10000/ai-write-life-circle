  "components": {
    "securitySchemes": {
      "authorBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "NovelAnalysisView": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "job": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "analysisId": {
                    "type": "string",
                    "pattern": "^ana-[0-9a-f]{24}$"
                  },
                  "bookId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "queued",
                      "running",
                      "paused",
                      "completed",
                      "failed",
                      "cancelled"
                    ]
                  },
                  "strategyVersion": {
                    "type": "string",
                    "minLength": 1
                  },
                  "createdAt": {
                    "type": "string"
                  },
                  "updatedAt": {
                    "type": "string"
                  },
                  "progress": {
                    "type": "object",
                    "properties": {
                      "total": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "pending": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "running": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "completed": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "failed": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "stale": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "total",
                      "pending",
                      "running",
                      "completed",
                      "failed",
                      "stale"
                    ],
                    "additionalProperties": false
                  },
                  "batches": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "batchId": {
                          "type": "string",
                          "pattern": "^batch-[0-9a-f]{24}$"
                        },
                        "chapterIds": {
                          "maxItems": 5,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "pattern": "^CH-\\d{1,6}$"
                          }
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "pending",
                            "running",
                            "completed",
                            "failed",
                            "stale"
                          ]
                        },
                        "phase": {
                          "type": "string",
                          "enum": [
                            "chapters",
                            "synthesis"
                          ]
                        },
                        "attempts": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "failureCode": {
                          "type": "string"
                        },
                        "taskId": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "batchId",
                        "chapterIds",
                        "status",
                        "phase",
                        "attempts"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "synthesisStatus": {
                    "type": "string",
                    "enum": [
                      "pending",
                      "running",
                      "completed",
                      "failed"
                    ]
                  }
                },
                "required": [
                  "analysisId",
                  "bookId",
                  "status",
                  "strategyVersion",
                  "createdAt",
                  "updatedAt",
                  "progress",
                  "batches",
                  "synthesisStatus"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "manifest": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "analysisId": {
                    "type": "string",
                    "pattern": "^ana-[0-9a-f]{24}$"
                  },
                  "bookId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "strategyVersion": {
                    "type": "string",
                    "minLength": 1
                  },
                  "createdAt": {
                    "type": "string"
                  },
                  "chapters": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "chapterId": {
                          "type": "string",
                          "pattern": "^CH-\\d{1,6}$"
                        },
                        "revisionId": {
                          "type": "string",
                          "minLength": 1
                        },
                        "contentHash": {
                          "type": "string",
                          "minLength": 1
                        },
                        "wordCount": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "volumeId": {
                          "type": "string"
                        },
                        "order": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "chapterId",
                        "revisionId",
                        "contentHash",
                        "wordCount",
                        "order"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "batches": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "batchId": {
                          "type": "string",
                          "pattern": "^batch-[0-9a-f]{24}$"
                        },
                        "chapterIds": {
                          "maxItems": 5,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "pattern": "^CH-\\d{1,6}$"
                          }
                        }
                      },
                      "required": [
                        "batchId",
                        "chapterIds"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "analysisId",
                  "bookId",
                  "strategyVersion",
                  "createdAt",
                  "chapters",
                  "batches"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "findingId": {
                  "type": "string",
                  "pattern": "^find-[0-9a-f]{24}$"
                },
                "analysisId": {
                  "type": "string",
                  "pattern": "^ana-[0-9a-f]{24}$"
                },
                "batchId": {
                  "type": "string",
                  "pattern": "^batch-[0-9a-f]{24}$"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "character",
                    "place",
                    "event",
                    "rule",
                    "relationship",
                    "thread",
                    "timeline",
                    "conflict",
                    "continuity"
                  ]
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "statement": {
                  "type": "string",
                  "minLength": 1
                },
                "alternativeExplanation": {
                  "type": "string"
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "proposed",
                    "author_confirmed",
                    "rejected",
                    "superseded",
                    "stale"
                  ]
                },
                "entityIds": {
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "evidence": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "chapterId": {
                        "type": "string",
                        "pattern": "^CH-\\d{1,6}$"
                      },
                      "revisionId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "contentHash": {
                        "type": "string",
                        "minLength": 1
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4000
                      },
                      "startUTF16": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "endUTF16": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "chapterId",
                      "revisionId",
                      "contentHash",
                      "quote",
                      "startUTF16",
                      "endUTF16"
                    ],
                    "additionalProperties": false
                  }
                },
                "createdAt": {
                  "type": "string"
                },
                "updatedAt": {
                  "type": "string"
                },
                "authorNote": {
                  "type": "string"
                }
              },
              "required": [
                "findingId",
                "analysisId",
                "batchId",
                "kind",
                "title",
                "statement",
                "confidence",
                "status",
                "entityIds",
                "evidence",
                "createdAt",
                "updatedAt"
              ],
              "additionalProperties": false
            }
          },
          "entities": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "entityId": {
                  "type": "string",
                  "pattern": "^went-[0-9a-f]{24}$"
                },
                "bookId": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "character",
                    "place",
                    "faction",
                    "item",
                    "rule",
                    "event",
                    "thread"
                  ]
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "aliases": {
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "description": {
                  "type": "string"
                },
                "attributes": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "observed",
                    "candidate",
                    "author_confirmed",
                    "rejected",
                    "superseded"
                  ]
                },
                "firstChapterId": {
                  "type": "string"
                },
                "lastChapterId": {
                  "type": "string"
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "chapterId": {
                        "type": "string",
                        "pattern": "^CH-\\d{1,6}$"
                      },
                      "revisionId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "contentHash": {
                        "type": "string",
                        "minLength": 1
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4000
                      },
                      "startUTF16": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "endUTF16": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
