{
  "schemas": {
    "ReviewAllowance": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "used": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reserved": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "remaining": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "resetsAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "unlimited": {
          "type": "boolean"
        }
      },
      "required": [
        "limit",
        "used",
        "reserved",
        "remaining",
        "resetsAt",
        "unlimited"
      ],
      "additionalProperties": false
    },
    "ChapterRevisionContent": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "chapterId": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "object",
          "properties": {
            "revisionId": {
              "type": "string",
              "minLength": 1
            },
            "parentRevisionId": {
              "type": [
                "string",
                "null"
              ]
            },
            "contentHash": {
              "type": "string",
              "minLength": 1
            },
            "wordCount": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "createdAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            "createdBy": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "author",
                    "agent",
                    "system"
                  ]
                },
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            },
            "commitRef": {
              "type": [
                "string",
                "null"
              ]
            },
            "markdown": {
              "type": "string"
            }
          },
          "required": [
            "revisionId",
            "contentHash",
            "markdown"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "chapterId",
        "revision"
      ],
      "additionalProperties": false
    },
    "WorkspaceResume": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "schema": {
          "type": "number",
          "const": 1
        },
        "chapterId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "view": {
          "type": "string",
          "enum": [
            "inspire",
            "read",
            "book"
          ]
        },
        "compose": {
          "type": "boolean"
        },
        "scroll": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "from": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000000
        },
        "to": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000000
        },
        "revisionId": {
          "type": "string",
          "maxLength": 512
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        }
      },
      "required": [
        "schema",
        "chapterId",
        "view",
        "compose",
        "scroll",
        "from",
        "to",
        "updatedAt"
      ],
      "additionalProperties": false
    }
  },
  "paths": {
    "/account": {
      "get": {
        "operationId": "getAuthorAccount",
        "summary": "Read current author point balances and account-level review quota",
        "tags": [
          "Account"
        ],
        "responses": {
          "200": {
            "description": "Current author account; review allowance resets on UTC calendar months",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "plan",
                    "review"
                  ],
                  "properties": {
                    "plan": {
                      "type": "string",
                      "enum": [
                        "free",
                        "plus",
                        "pro"
                      ]
                    },
                    "review": {
                      "$ref": "#/components/schemas/ReviewAllowance"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Author login required"
          }
        }
      }
    },
    "/projects/{projectId}/chapters/{chapterId}/revisions/{revisionId}": {
      "get": {
        "operationId": "getChapterRevisionContent",
        "summary": "Read immutable author-owned revision content",
        "tags": [
          "Revisions"
        ],
        "x-required-role": [
          "author"
        ],
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "chapterId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "revisionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Verified historical Markdown without private receipts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChapterRevisionContent"
                }
              }
            }
          },
          "401": {
            "description": "Not authorized or not found"
          },
          "403": {
            "description": "Not authorized or not found"
          },
          "404": {
            "description": "Not authorized or not found"
          }
        }
      }
    }
  }
}
