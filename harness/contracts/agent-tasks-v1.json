          },
          "activeTasks": {
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "ready": {
            "type": "boolean"
          }
        },
        "required": [
          "instance",
          "version",
          "configFingerprint",
          "kinds",
          "activeTasks",
          "ready"
        ],
        "additionalProperties": false
      }
    }
  }
}
