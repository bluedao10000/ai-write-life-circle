{
  "name": "@writer-agent/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "lint": "../../apps/web/node_modules/.bin/eslint --config ../../apps/web/eslint.config.js src test",
    "start": "node dist/main.js",
    "dev:worker": "tsx src/worker/main.ts",
    "start:worker": "node dist/worker/main.js"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@writer-agent/contracts": "workspace:*",
    "typebox": "1.3.27",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "4.23.15",
    "typescript": "^5.7.0"
  },
  "files": [
    "dist",
    "skills"
  ]
}
