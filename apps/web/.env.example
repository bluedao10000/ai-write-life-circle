# PostgreSQL 配置
DB_NAME=greenfield_adventures
DB_USER=postgres
DB_PASSWORD=YOUR_SECURE_PASSWORD_HERE_MIN_32_CHARS
DB_PORT=5432

# Web 应用配置
WEB_PORT=3000

# Writer Agent 模式：demo 或 api
WRITER_AGENT_MODE=demo

# API 配置（当 WRITER_AGENT_MODE=api 时需要）
API_URL=http://api:8000

# GitHub Container Registry 镜像（生产环境）
GHCR_IMAGE=ghcr.io/story2u/ai-write-life-circle:latest

# 其他环境变量
NODE_ENV=production
