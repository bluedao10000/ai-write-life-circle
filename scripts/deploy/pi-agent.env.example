# Root:writer-agent-pi 0640. Never commit an actual key.
WRITER_AGENT_PI_PORT=8790
WRITER_AGENT_PI_STATE_DIR=/var/lib/writer-agent-pi
WRITER_AGENT_PI_STORY_ORIGIN=http://127.0.0.1:8791
WRITER_AGENT_PI_SERVICE_TOKEN_FILE=/etc/writer-agent-pi-rpc/service.token
WRITER_AGENT_PI_LLM_API_KEY=REPLACE_LOCALLY
# Defaults when omitted: https://api.deepseek.com / deepseek-flash.
# These are independent of the existing Go Worker's model settings.
WRITER_AGENT_PI_LLM_BASE_URL=https://api.deepseek.com
WRITER_AGENT_PI_LLM_MODEL=deepseek-flash
WRITER_AGENT_PI_MAX_TURNS=6
WRITER_AGENT_PI_MAX_TOOLS=12
WRITER_AGENT_PI_MAX_INPUT_TOKENS=32000
WRITER_AGENT_PI_MAX_OUTPUT_TOKENS=2048
WRITER_AGENT_PI_MAX_SESSION_TOKENS=200000
WRITER_AGENT_PI_MAX_CONCURRENT=2
WRITER_AGENT_PI_MAX_DURATION_MS=120000
WRITER_AGENT_PI_MAX_RESULT_BYTES=24000
