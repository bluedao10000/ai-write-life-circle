# root:writer-agent-pi-worker 0640; never copy a real key into Git.
WRITER_AGENT_TASK_ORIGIN=http://127.0.0.1:8792
WRITER_AGENT_TASK_SERVICE_TOKEN_FILE=/etc/writer-agent-pi-task-rpc/service.token
WRITER_AGENT_PI_WORKER_VERSION=RELEASE_COMMIT
WRITER_AGENT_PI_WORKER_LLM_API_KEY=REPLACE_LOCALLY
# Keep these public settings identical to the Go API execution disclosure.
WRITER_AGENT_PI_WORKER_LLM_PROVIDER=openai-compatible
WRITER_AGENT_PI_WORKER_LLM_BASE_URL=https://api.deepseek.com
WRITER_AGENT_PI_WORKER_LLM_MODEL=deepseek-flash
WRITER_AGENT_PI_WORKER_LLM_RESPONSE_FORMAT=json_object
WRITER_AGENT_PI_WORKER_LLM_TOKEN_PARAMETER=max_tokens
WRITER_AGENT_PI_WORKER_LLM_TIMEOUT_SECONDS=180
WRITER_AGENT_PI_WORKER_LLM_MAX_OUTPUT_TOKENS=131072
WRITER_AGENT_PI_WORKER_MAX_CONTEXT_BYTES=65536
WRITER_AGENT_PI_WORKER_MAX_CONCURRENT=2
