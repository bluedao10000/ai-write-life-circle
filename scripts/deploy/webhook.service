[Unit]
Description=GitHub Webhook Auto-Deploy Service
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/greenfield-adventures
Environment="WEBHOOK_PORT=9000"
Environment="WEBHOOK_SECRET=your_secret_here_change_me"
Environment="PROJECT_DIR=/home/ubuntu/greenfield-adventures"
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
ExecStart=/usr/bin/node /home/ubuntu/greenfield-adventures/scripts/deploy/webhook-server.js
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
