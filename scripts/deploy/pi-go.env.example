# Add to API's existing environment only after installing compatible Go build.
# Do not add the model credential to Go API's environment.
WRITER_AGENT_PI_ORIGIN=http://127.0.0.1:8790
WRITER_AGENT_PI_INTERNAL_HOST=127.0.0.1
WRITER_AGENT_PI_INTERNAL_PORT=8791
WRITER_AGENT_PI_SERVICE_TOKEN_FILE=/etc/writer-agent-pi-rpc/service.token
WRITER_AGENT_PI_CAPABILITY_KEY_FILE=/etc/writer-agent/pi-capability.key
