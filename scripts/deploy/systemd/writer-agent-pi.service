[Unit]
Description=Writer Agent private Pi Thinking service
After=network.target writer-agent-api.service

[Service]
Type=simple
User=writer-agent-pi
Group=writer-agent-pi
SupplementaryGroups=writer-agent-pi-rpc
EnvironmentFile=/etc/writer-agent-pi/agent.env
ExecStartPre=/usr/bin/node /opt/writer-agent-pi/current/dist/main.js --check-config
ExecStart=/usr/bin/node /opt/writer-agent-pi/current/dist/main.js
WorkingDirectory=/var/lib/writer-agent-pi
StateDirectory=writer-agent-pi
StateDirectoryMode=0700
UMask=0077
CPUQuota=100%
MemoryMax=768M
TasksMax=64
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
InaccessiblePaths=-/var/lib/writer-agent -/srv/writer-agent -/etc/writer-agent

[Install]
WantedBy=multi-user.target
