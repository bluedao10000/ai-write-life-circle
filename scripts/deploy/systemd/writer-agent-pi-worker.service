[Unit]
Description=Writer Agent private Pi background executor
After=network.target writer-agent-api.service

[Service]
Type=simple
User=writer-agent-pi-worker
Group=writer-agent-pi-worker
SupplementaryGroups=writer-agent-pi-task-rpc
EnvironmentFile=/etc/writer-agent-pi-worker/worker.env
ExecStartPre=/opt/writer-agent-pi/node/bin/node /opt/writer-agent-pi/current/dist/worker/main.js --check-config
ExecStart=/opt/writer-agent-pi/node/bin/node /opt/writer-agent-pi/current/dist/worker/main.js
WorkingDirectory=/var/lib/writer-agent-pi-worker
StateDirectory=writer-agent-pi-worker
StateDirectoryMode=0700
UMask=0077
CPUQuota=100%
MemoryMax=768M
TasksMax=64
Restart=on-failure
RestartSec=5
TimeoutStopSec=40
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
InaccessiblePaths=-/var/lib/writer-agent -/srv/writer-agent -/etc/writer-agent -/var/backups/writer-agent -/var/lib/writer-agent-pi -/etc/writer-agent-pi -/etc/writer-agent-pi-rpc

[Install]
WantedBy=multi-user.target
