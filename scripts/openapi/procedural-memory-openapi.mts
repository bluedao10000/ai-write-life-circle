import {readFile,writeFile} from 'node:fs/promises';
import {z} from 'zod';
import * as c from '../../packages/contracts/src/procedural-memory.js';
const schemas=Object.fromEntries(Object.entries(c).map(([k,v])=>[k.slice(0,-6),z.toJSONSchema(v as z.ZodType,{target:'draft-2020-12'})]));
const ref=(name:string)=>({$ref:'#/components/schemas/'+name});
const parameter=(name:string)=>({name,in:'path',required:true,schema:{type:'string'}});
const operation=(id:string,output:string,input?:string)=>({operationId:id,summary:id,security:[{bearerAuth:[]}],...(input?{parameters:[{name:'Idempotency-Key',in:'header',required:true,schema:{type:'string'}}],requestBody:{required:true,content:{'application/json':{schema:ref(input)}}}}:{}),responses:{[id==='createProceduralMemory'?'201':'200']:{description:'Successful operation',content:{'application/json':{schema:ref(output)}}},'401':{description:'Author authentication required'},'404':{description:'Book or source unavailable'},'409':{description:'Version or lifecycle conflict'},'410':{description:'Memory deleted'},'422':{description:'Invalid input or insufficient evidence'}}});
const root='/v1/studio/books/{bookId}/procedural-memory';
const paths={[root+'/evidence/{taskId}']:{parameters:[parameter('bookId'),parameter('taskId')],get:operation('readProceduralSource','proceduralSource')},[root+'/{memoryId}/merge']:{parameters:[parameter('bookId'),parameter('memoryId')],post:operation('mergeProceduralMemory','proceduralRecord','proceduralMerge')},[root]:{parameters:[parameter('bookId')],get:operation('listProceduralMemory','proceduralList'),post:operation('createProceduralMemory','proceduralRecord','proceduralCreate')},[root+'/evidence']:{parameters:[parameter('bookId')],get:operation('listProceduralEvidence','proceduralEvidenceList')},[root+'/{memoryId}']:{parameters:[parameter('bookId'),parameter('memoryId')],post:operation('decideProceduralMemory','proceduralRecord','proceduralDecision')}};
const output=JSON.stringify({openapi:'3.1.0',info:{title:'Procedural Memory',version:'procedural-memory-v1',license:{name:'Private application protocol'}},servers:[{url:'http://127.0.0.1:8787'}],paths,components:{securitySchemes:{bearerAuth:{type:'http',scheme:'bearer'}},schemas}},null,2)+'\n';
const path='harness/contracts/procedural-memory-v1.json';
if(process.argv.includes('--check')){if(await readFile(path,'utf8')!==output)throw Error('Procedural memory contract drift')}else await writeFile(path,output);
